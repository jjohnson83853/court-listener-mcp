# CourtListener MCP Server - environment template
# Copy to .env and fill in values. Do NOT commit .env.

# CourtListener API credentials
COURT_LISTENER_API_KEY=

# File cache (dir is bind-mounted at /app/.cache in docker-compose.yml)
COURTLISTENER_CACHE_DIR=.cache/court-listener/
COURTLISTENER_CACHE_TTL_STATIC=2592000
COURTLISTENER_CACHE_TTL_DOCKETS=86400
COURTLISTENER_CACHE_MAX_MB=100